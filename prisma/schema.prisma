generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  DOCTOR
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

enum PaymentProvider {
  YOOKASSA
}

enum PaymentStatus {
  PENDING
  WAITING_FOR_CAPTURE
  SUCCEEDED
  CANCELED
}

model User {
  id               Int       @id @default(autoincrement())
  phone            String?   @unique
  isPhoneVerified  Boolean   @default(false) @map("is_phone_verified")
  email            String?   @unique
  password         String?   @map("password_hash")
  telegramId       String?   @unique @map("telegram_id")
  telegramUsername String?   @map("telegram_username")
  yandexId         String?   @unique @map("yandex_id")
  vkId             String?   @unique @map("vk_id")
  role             UserRole
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  middleName       String?   @map("middle_name")
  companyName      String?   @map("company_name")
  referralCode     String?   @map("referral_code")
  specialtyId      Int?      @map("specialty_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  specialty         Specialty?        @relation(fields: [specialtyId], references: [id])
  specialtyLinks    UserSpecialty[]
  organizedSeminars Seminar[]
  cartItems         SeminarCart[]
  bookings          SeminarBooking[]
  seminarFavorites  SeminarFavorite[]
  seminarViews      SeminarView[]
  seminarPayments   SeminarPayment[]
  lecturer          Lecturer?
  pushTokens        PushToken[]

  @@map("users")
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  phone     String
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Specialty {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users             User[]
  userSpecialtyLinks UserSpecialty[]
  seminars          Seminar[]

  @@map("specialties")
}

model UserSpecialty {
  userId      Int @map("user_id")
  specialtyId Int @map("specialty_id")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([userId, specialtyId])
  @@index([specialtyId])
  @@map("user_specialties")
}

model SeminarFormat {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  seminars Seminar[]

  @@map("seminar_formats")
}

model Lecturer {
  id              Int       @id @default(autoincrement())
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  middleName      String?   @map("middle_name")
  position        String
  yearsExperience Int       @map("years_experience")
  achievements    Json      @default("[]")
  photoUrl        String?   @map("photo_url")
  bio             String?
  isActive        Boolean   @default(true) @map("is_active")
  userId          Int?      @unique @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user     User?     @relation(fields: [userId], references: [id])
  seminars Seminar[]

  @@map("lecturers")
}

model Seminar {
  id              Int       @id @default(autoincrement())
  title           String
  description     String
  topic           String?
  city            String
  price           Decimal   @db.Decimal(10, 2)
  eventDate       DateTime  @map("event_date")
  eventTime       String    @map("event_time")
  contactPhone    String?   @map("contact_phone")
  secondaryPhone  String?   @map("secondary_phone")
  contactEmail    String?   @map("contact_email")
  contactTelegram String?   @map("contact_telegram")
  isActive        Boolean   @default(true) @map("is_active")
  organizerId     Int       @map("organizer_id")
  lecturerId      Int       @map("lecturer_id")
  formatId        Int       @map("format_id")
  specialtyId     Int?      @map("specialty_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  organizer User              @relation(fields: [organizerId], references: [id])
  lecturer  Lecturer          @relation(fields: [lecturerId], references: [id])
  format    SeminarFormat     @relation(fields: [formatId], references: [id])
  specialty Specialty?        @relation(fields: [specialtyId], references: [id])
  cartItems SeminarCart[]
  bookings  SeminarBooking[]
  favorites SeminarFavorite[]
  views     SeminarView[]
  payments  SeminarPayment[]
  eventDays SeminarEventDay[]
  photos    SeminarPhoto[]

  @@index([organizerId])
  @@index([lecturerId])
  @@index([formatId])
  @@index([specialtyId])
  @@index([eventDate])
  @@index([city])
  @@map("seminars")
}

model SeminarEventDay {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  date      DateTime
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  @@index([seminarId])
  @@index([date])
  @@map("seminar_event_days")
}

model SeminarPhoto {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)

  @@index([seminarId])
  @@index([seminarId, order])
  @@map("seminar_photos")
}

model SeminarCart {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seminarId, userId])
  @@index([seminarId])
  @@index([userId])
  @@map("seminar_cart")
}

model SeminarBooking {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  userId    Int      @map("user_id")
  paymentId Int?     @unique @map("payment_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seminar Seminar         @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment SeminarPayment? @relation(fields: [paymentId], references: [id])

  @@unique([seminarId, userId])
  @@index([seminarId])
  @@index([userId])
  @@index([status])
  @@map("seminar_bookings")
}

model SeminarPayment {
  id                Int             @id @default(autoincrement())
  seminarId         Int             @map("seminar_id")
  userId            Int             @map("user_id")
  provider          PaymentProvider
  providerPaymentId String?         @unique @map("provider_payment_id")
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("RUB")
  confirmationUrl   String?         @map("confirmation_url")
  description       String?
  metadata          Json?
  paidAt            DateTime?        @map("paid_at")
  cancelledAt       DateTime?        @map("cancelled_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking SeminarBooking?

  @@index([seminarId])
  @@index([userId])
  @@index([status])
  @@map("seminar_payments")
}

model SeminarFavorite {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seminarId, userId])
  @@index([seminarId])
  @@index([userId])
  @@map("seminar_favorites")
}

model SeminarView {
  id        Int      @id @default(autoincrement())
  seminarId Int      @map("seminar_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  seminar Seminar @relation(fields: [seminarId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seminarId, userId])
  @@index([seminarId])
  @@index([userId])
  @@index([createdAt])
  @@map("seminar_views")
}

model PushToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  deviceId  String    @map("device_id")
  token     String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("push_tokens")
}
